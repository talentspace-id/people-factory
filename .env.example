# Local Postgres (see docker-compose.yml) — app connects as app_user, never as postgres.
DATABASE_URL="postgresql://app_user:app_user@localhost:5432/people_factory"
MIGRATE_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/people_factory"

# Base URL used to build magic-link and invite URLs.
APP_BASE_URL="http://localhost:3000"

# No email provider wired yet — magic links and invite links are logged to the
# server console in dev. Set a real provider's key here when one is added.
EMAIL_FROM="no-reply@peoplefactory.id"
